{
  "manifest_version": 3,
  "name": "Monty Filters: Improved Browsing for Montagne Parfums",
  "short_name": "Monty Filters",
  "version": "1.1.1",
  "description": "Hide sold-out items, search, sort, and spot new or restocked fragrances on montagneparfums.com. Unofficial.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Switch between in-stock and all items",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.montagneparfums.com/*", "*://montagneparfums.com/*"],
      "js": ["history.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.montagneparfums.com/*", "*://montagneparfums.com/*"],
      "js": ["page-stock.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
